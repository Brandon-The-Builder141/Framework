# Guru bot — separate Discord application from Solen
# Copy to guru/.env and fill in from https://discord.com/developers/applications

GURU_DISCORD_BOT_TOKEN=your_guru_bot_token_here
GURU_OWNER_ID=your_discord_user_id

# Same OpenRouter key as Solen (required for conversation + personality)
OPENROUTER_API_KEY=your_openrouter_key
GARTH_MODEL=openai/gpt-oss-120b:free
